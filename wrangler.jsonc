// Cloudflare Workers の設定。画面（dist）と対戦サーバー（/api/room）を同じ Worker で配信する。
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sushi-battle",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "RoomLobby" }]
  },
  // 無料プランでは SQLite 方式の Durable Object を使う。
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RoomLobby"] }],
  "observability": { "enabled": true }
}
